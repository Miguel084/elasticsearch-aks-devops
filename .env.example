# Azure
AZ_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZ_RESOURCE_GROUP=rg-elasticsearch
AZ_LOCATION=eastus
AKS_CLUSTER_NAME=aks-elasticsearch
ACR_NAME=acrelasticsearch
AKS_NODE_VM_SIZE=Standard_D4s_v3

# Kubernetes / Helm
K8S_NAMESPACE=elasticsearch
HELM_RELEASE_NAME=elasticsearch

# Azure DevOps Pipeline service connections
DOCKER_REGISTRY_SERVICE_CONNECTION=your-acr-connection
KUBERNETES_SERVICE_CONNECTION=your-aks-connection
CONTAINER_REGISTRY=yourregistry.azurecr.io
